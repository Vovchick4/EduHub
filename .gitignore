# ==========================================
# 1. Специфічне для Frontend (React / Node)
# ==========================================
node_modules/
/dist
/build
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 2. Специфічне для Backend (Django / Python)
# ==========================================
# Байти та кеш Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Віртуальне оточення (Virtual Environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# База даних (локальна SQLite)
db.sqlite3
db.sqlite3-journal
# 1. Секрети та конфігурації (КРИТИЧНО)
# Локальні файли конфігурації, де ви прописуєте паролі до вашої SQL бази даних
.env
.env.local
secrets.json
local_settings.py

# 2. Дампи та бекапи бази даних
# Сюди потраплятимуть файли експорту бази даних, якщо ви будете робити бекапи локально
*.sql
*.sql.gz
*.dump
*.bak
# Медіа та статичні файли Django (якщо збираються локально)
/staticfiles/
/media/

# Логи Django
*.log

# ==========================================
# 3. Секрети та змінні оточення (КРИТИЧНО)
# ==========================================
.env
.env.local
.env.*.local
*.env
secrets.json

# ==========================================
# 4. Налаштування IDE / Редакторів
# ==========================================
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm)
.idea/

# Сміття операційних систем
.DS_Store
Thumbs.db
